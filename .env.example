# Server & Security
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/messenger_db
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/messenger_test
JWT_SECRET=supersecretjwtkeyatleast32characterslong123456
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (BullMQ queue & caching)
REDIS_URL=redis://127.0.0.1:6379

# ClamAV (Antivirus daemon)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Cloudflare R2 (S3-compatible Object Storage)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=messenger-media
R2_PUBLIC_DOMAIN=https://media.example.com
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Media & File Processing Limits
VIDEO_MAX_DURATION_SECONDS=600
DOCUMENT_MAX_SIZE_BYTES=52428800
VIDEO_MAX_SIZE_BYTES=209715200
IMAGE_MAX_SIZE_BYTES=20971520
PDF_MAX_SIZE_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=1073741824
USER_DAILY_UPLOAD_LIMIT_BYTES=524288000
LIBREOFFICE_TIMEOUT_MS=120000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Phase 6 Group Chat & Search
MAX_GROUP_MEMBERS=256
SEARCH_RATE_LIMIT_PER_MINUTE=30
