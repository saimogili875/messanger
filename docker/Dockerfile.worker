# docker/Dockerfile.worker
# Isolated worker container packaging LibreOffice headless and FFmpeg with resource isolation.

FROM node:22-bookworm-slim

# Install LibreOffice headless, FFmpeg, poppler-utils (pdftoppm), and ClamAV client
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-nogui \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    ffmpeg \
    poppler-utils \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install --legacy-peer-deps

COPY . .
RUN npm run build

# Run worker with low CPU priority (nice -n 19) to protect core API server latency
CMD ["nice", "-n", "19", "node", "dist/workers/media.worker.js"]

